MODEL_ID=SupersonicLabs/Julia-1
# Keep checkpoint and installed runtime revisions aligned; see README for upgrades.
MODEL_REVISION=a85b127321d580d65176c89ced8273f305745d85
DEVICE=cpu
MAX_LENGTH=8192
HEAD_LENGTH=512
CPU_THREADS=4
HOST=0.0.0.0
PORT=8000
# Includes the running request and waiting requests; excess requests receive 503.
MAX_PENDING_REQUESTS=16
# Per-client requests per minute, with short bursts allowed; 0 disables. /health is exempt.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
# Header holding the real client IP when behind a proxy, e.g. CF-Connecting-IP for a
# Cloudflare Tunnel. Leave empty unless every request passes through that proxy.
CLIENT_IP_HEADER=
# Comma-separated bearer tokens required by /v1 endpoints; empty leaves the API open.
# Generate one with: openssl rand -hex 32
API_KEYS=
# HF_HOME defaults to ~/.cache/huggingface; Compose sets the persistent mount path.
# HF_HUB_OFFLINE=1
# Runtime Umami website ID for playground analytics; empty disables analytics.
# Recreate the container after changing it; no image rebuild is needed.
UMAMI_WEBSITE_ID=
